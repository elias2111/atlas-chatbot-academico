      "item": [
        {
          "name": "1. Conexión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{n8n_url}}/webhook/atlas-chat",
              "host": [
                "{{n8n_url}}"
              ],
              "path": [
                "webhook",
                "atlas-chat"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"postman\",\n  \"studentId\": \"20221045\",\n  \"message\": \"ping de conexión desde la app\",\n  \"context\": {}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Trae reply', () => pm.expect(pm.response.json().reply).to.be.a('string'));"
                ]
              }
            }
          ]
        },
