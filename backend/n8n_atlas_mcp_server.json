      "name": "consultar_estado_academico",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        -500,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Devuelve el estado académico completo de un estudiante: programa, periodo, estado de matrícula, créditos aprobados y en curso, porcentaje de avance, promedio (PGA), materias en curso y pendientes con prerrequisitos faltantes. Parámetro: codigo del estudiante.",
        "operation": "executeQuery",
        "query": "SELECT fn_contexto_estudiante($1) AS resultado;",
        "options": {
          "queryReplacement": "={{ $fromAI('codigo', 'Codigo del estudiante por ejemplo 20221045', 'string') }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REEMPLAZAR",
          "name": "Postgres ATLAS (Supabase)"
        }
      }
    },
    {
      "id": "0b73fc6b-1eda-4779-a70e-aceed72180b9",
      "name": "consultar_notas_semestre",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        -300,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Devuelve las notas del semestre actual por materia (escala 0,0 a 5,0): evaluaciones con corte, peso y nota; nota actual; acumulado; nota necesaria para aprobar con 3,0 y estado (APROBANDO, EN RIESGO, APROBADA ASEGURADA, PERDIDA, APROBADA, REPROBADA). Parámetro: codigo del estudiante.",
        "operation": "executeQuery",
        "query": "SELECT fn_notas_semestre($1) AS resultado;",
        "options": {
          "queryReplacement": "={{ $fromAI('codigo', 'Codigo del estudiante', 'string') }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REEMPLAZAR",
          "name": "Postgres ATLAS (Supabase)"
        }
      }
    },
    {
      "id": "a5f84dcd-149e-4e1f-876c-fca63ede6dc1",
      "name": "consultar_tareas",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        -100,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Lista las tareas del estudiante con fecha de entrega, días restantes, estado y avance. Parámetros: codigo del estudiante y categoria opcional (vencida, incompleta, por hacer, entregada) o vacío para todas.",
        "operation": "executeQuery",
        "query": "SELECT fn_tareas($1, NULLIF($2, 'todas')) AS resultado;",
        "options": {
          "queryReplacement": "={{ $fromAI('codigo', 'Codigo del estudiante', 'string') }},{{ $fromAI('categoria', 'vencida, incompleta, por hacer, entregada o todas', 'string') || 'todas' }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REEMPLAZAR",
          "name": "Postgres ATLAS (Supabase)"
        }
      }
    },
    {
      "id": "972a9e95-824b-4364-8bd6-f465a80e362e",
      "name": "consultar_prerrequisitos",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        100,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Devuelve los prerrequisitos de una asignatura del plan de Ingeniería de Sistemas y las asignaturas que desbloquea. Parámetro: nombre o código de la asignatura.",
        "operation": "executeQuery",
        "query": "SELECT fn_prerrequisitos($1) AS resultado;",
        "options": {
          "queryReplacement": "={{ $fromAI('asignatura', 'Nombre o codigo de la asignatura', 'string') }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REEMPLAZAR",
          "name": "Postgres ATLAS (Supabase)"
        }
      }
    },
    {
      "id": "cccfdde7-dc44-4f97-81cc-9ff7b837a5dc",
      "name": "noticias_del_dia",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        300,
        260
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Devuelve las noticias de las últimas 48 horas sobre educación, tecnología e ingeniería de sistemas (título, fuente, fecha, enlace). Parámetro: categoria opcional (Educación, Tecnología, Ingeniería de sistemas) o vacío.",
        "operation": "executeQuery",
        "query": "SELECT COALESCE(json_agg(n), '[]') AS resultado FROM (SELECT titulo, fuente, categoria, fecha, url FROM v_noticias_hoy WHERE ($1 = 'todas' OR unaccent_lower(categoria) = unaccent_lower($1)) LIMIT 10) n;",
        "options": {
          "queryReplacement": "={{ $fromAI('categoria', 'Educacion, Tecnologia, Ingenieria de sistemas o todas', 'string') || 'todas' }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REEMPLAZAR",
          "name": "Postgres ATLAS (Supabase)"
        }
      }
    },
